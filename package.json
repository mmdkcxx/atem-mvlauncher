{
  "name": "atem-webcam-out-controller",
  "version": "0.1.0",
  "private": true,
  "description": "ATEM Webcam Out Controller",
  "scripts": {
    "diagnose": "node scripts/diagnose.js",
    "test": "node --test",
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "dependencies": {
    "atem-connection": "3.10.3"
  },
  "main": "src/main.js",
  "devDependencies": {
    "bonjour-service": "1.4.4",
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "local.atem.mvlauncher",
    "productName": "ATEM MV Launcher",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "ATEM-MV-Launcher-Setup-${version}.${ext}"
    },
    "npmRebuild": false
  }
}
